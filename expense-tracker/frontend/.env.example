# Base path for the upload-URL API request.
# In production this is left as the same-origin relative "/api": the nginx
# container serves the built SPA and reverse-proxies /api/* to the
# CreateUploadURL Cloud Run service (option B: same-origin, no CORS).
# For local dev against a backend on another origin, point it at that origin,
# e.g. VITE_API_BASE=http://localhost:8080
VITE_API_BASE=/api
